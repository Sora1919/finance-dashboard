# Database migration connection
DATABASE_URL="mysql://USERNAME:PASSWORD@HOST:3306/finance_dashboard"

# Prisma MariaDB adapter
DATABASE_HOST="127.0.0.1"
DATABASE_PORT="3306"
DATABASE_USER="your_database_user"
DATABASE_PASSWORD="your_database_password"
DATABASE_NAME="finance_dashboard"

# Auth.js
AUTH_SECRET="replace-with-a-secure-random-secret"

# Configure host trust for your deployment environment if required.
# AUTH_TRUST_HOST=true